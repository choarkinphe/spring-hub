# --- Build output ---------------------------------------------------------
# Retired Rust build artifacts; keep ignored if restored from Git history.
/target/

# Python bytecode caches.
__pycache__/
*.py[cod]

# --- Local state / secrets ------------------------------------------------
# Real env files (see *.example). Never commit filled-in credentials.
.env
.env.*
!.env.handbrake.example

# SQLite databases and their WAL/SHM sidecars. Must live on local storage.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Machine-local Claude Code state (permission allowlist, absolute paths).
.claude/settings.local.json

# --- Runtime / editor noise -----------------------------------------------
*.log
*.tmp
.DS_Store
Thumbs.db
