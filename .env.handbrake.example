# Copy to .env and fill in for compose.handbrake.yaml.
# NEVER commit the filled-in file. Add `.env` to .gitignore.

# --- Local media directory (bind mount) ---
SPRINGHUB_MEDIA=./media

# --- API token (required for anything beyond loopback) ---
# SPRINGHUB_API_TOKEN=change-me-to-a-long-random-string

# --- NFS volume ---
# NFS_HOST=192.168.1.10
# NFS_PATH=/volume1/video

# --- SMB/CIFS volume ---
# SMB_HOST=192.168.1.20
# SMB_SHARE=video
# Path to a credentials file on the HOST (mode 600), not the secrets inline.
# SMB_CREDENTIALS_FILE=/etc/cute-cat/smb.credentials
